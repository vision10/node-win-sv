{
  "name": "win-sv",
  "version": "1.0.0",
  "description": "Run Node.js scripts (or any executable) as native Windows services using WinSW. Includes event logging and process helpers. Zero dependencies.",
  "author": "Sorin Muresan <sorinm025@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vision10/node-win-sv.git"
  },
  "keywords": [
    "windows",
    "service",
    "services",
    "daemon",
    "logging",
    "event",
    "event logging",
    "elevate",
    "process",
    "winsw",
    "manager",
    "install"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "CHANGELOG.md",
    "lib/",
    "bin/cli.js",
    "bin/WinSW.exe",
    "bin/WinSW.LICENSE.txt"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "bin": {
    "win-sv": "bin/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "test:service": "node tests/integration.js"
  }
}
