{
  "name": "win-sv",
  "version": "1.0.0",
  "description": "Run Node.js scripts (or any executable) as native Windows services, hosted by a small native wrapper (no .NET needed). Includes service, process and event log helpers, and a CLI. Zero dependencies.",
  "author": "Sorin Muresan <sorinm025@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vision10/node-win-sv.git"
  },
  "keywords": [
    "windows",
    "service",
    "services",
    "daemon",
    "logging",
    "event",
    "event logging",
    "elevate",
    "process",
    "winsw",
    "winsv",
    "manager",
    "install"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "CHANGELOG.md",
    "LICENSE",
    "lib/",
    "bin/cli.js",
    "bin/winsv.exe",
    "bin/winsv.LICENSE.txt"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "bin": {
    "win-sv": "bin/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "test:acceptance": "node tests/acceptance/run.js"
  }
}
